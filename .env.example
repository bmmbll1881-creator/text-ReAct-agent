# Copy this file to .env and replace placeholders with local values.
# Never commit .env: it may contain API keys and other secrets.
DEEPSEEK_API_KEY=
CHAT_URL=
LLM_MODEL=deepseek-chat
MAX_STEPS=10
WORKSPACE=./workspace
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
TOOL_TIMEOUT=30
LLM_TIMEOUT=120
CONTEXT_TOKEN_LIMIT=4000
CONTEXT_KEEP_RECENT_MESSAGES=4
MAX_READ_CHARS=100000
MAX_WRITE_CHARS=100000
MAX_OBSERVATION_CHARS=2000
ALLOWED_SUFFIXES=.txt,.md,.py,.json,.yml,.yaml,.env.example
EMIT_THOUGHT=true
MAX_CONCURRENT_RUNS=10
MAX_QUEUE_SIZE=100
MAX_TASK_LENGTH=10000
MAX_SESSION_ID_LENGTH=128
SSE_KEEPALIVE_SECONDS=15
EVENT_QUEUE_PUT_TIMEOUT=5

# ---- MCP 知识库服务（evidence-reflective-trace-rag）----
# 关闭时 Agent 只加载本地文件工具，便于单独调试
RAG_MCP_ENABLED=false
RAG_MCP_PYTHON=E:\PycharmProjects\evidence-reflective-trace-rag\.venv\Scripts\python.exe
RAG_MCP_PROJECT=E:\PycharmProjects\evidence-reflective-trace-rag
RAG_MCP_DATA_DIR=E:\PycharmProjects\evidence-reflective-trace-rag\demo\data
RAG_MCP_STARTUP_TIMEOUT=15
RAG_MCP_TOOL_TIMEOUT=60
RAG_MCP_DEFAULT_KB=financial_report
RAG_MCP_KB_ALIASES=financial_report=财务报告,contract=合同条款
RAG_MCP_MAX_CONCURRENCY=2
