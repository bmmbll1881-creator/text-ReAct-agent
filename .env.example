# Copy this file to .env and replace placeholders with local values.
# Never commit .env: it may contain API keys and other secrets.

DEEPSEEK_API_KEY=your_api_key_here

# Required LLM chat-completions endpoint (no default in application config).
CHAT_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-3.5-turbo

MAX_STEPS=10
WORKSPACE=./workspace
# WORK_SPACE=./workspace  # Legacy alias; WORKSPACE takes precedence.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
TOOL_TIMEOUT=30
LLM_TIMEOUT=120
CONTEXT_TOKEN_LIMIT=4000
CONTEXT_KEEP_RECENT_MESSAGES=4
MAX_READ_CHARS=100000
MAX_WRITE_CHARS=100000
ALLOWED_SUFFIXES=.txt,.md,.py,.json,.yml,.yaml,.env.example
