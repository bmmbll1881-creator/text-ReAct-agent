[
  {
    "name": "summarize_experiment",
    "category": "multi_step",
    "prompt": "Read experiment/config.json and experiment/results.md, write experiment/summary.md",
    "expected": {
      "all": [
        "baseline",
        "86%"
      ]
    },
    "setup": [
      {
        "file": "experiment/config.json",
        "content": "{\"model\":\"baseline\"}"
      },
      {
        "file": "experiment/results.md",
        "content": "accuracy 86%"
      }
    ],
    "expected_files": [
      "experiment/summary.md"
    ]
  },
